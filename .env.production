# ============================================================================
# NetWeaver Production Environment Configuration
# ============================================================================
# Copy this file to .env and set all values before deploying to production:
#   cp .env.production .env
#   vim .env   # Set all values
#   docker-compose -f docker-compose-production.yml up -d
# ============================================================================

# ── Domain & TLS ──────────────────────────────────────────────────────────
DOMAIN=netweaver.example.com
CERTBOT_EMAIL=admin@example.com

# ── JWT Authentication ────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_KEY

# Token lifetime in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Database ──────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=CHANGE_ME_GENERATE_A_SECURE_PASSWORD
DB_NAME=netweaver
DB_USER=netweaver

# ── RabbitMQ ──────────────────────────────────────────────────────────────
RABBITMQ_USER=netweaver
RABBITMQ_PASS=CHANGE_ME_GENERATE_A_SECURE_PASSWORD

# ── Environment ───────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── CORS ──────────────────────────────────────────────────────────────────
# Set to your actual frontend domain (NO wildcards in production!)
ALLOWED_ORIGINS=https://netweaver.example.com

# ── Security ──────────────────────────────────────────────────────────────
CSRF_PROTECTION=true
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ── WAF/CDN (optional) ───────────────────────────────────────────────────
# If behind Cloudflare/AWS Shield, set to trust their proxy headers
# TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22
