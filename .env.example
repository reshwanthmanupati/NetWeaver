# ============================================================================
# NetWeaver Production Environment Configuration
# ============================================================================
# Copy this file to .env and customize for your deployment
# NEVER commit .env to version control
# ============================================================================

# ─── General ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
COMPOSE_PROJECT_NAME=netweaver

# ─── Domain & TLS ─────────────────────────────────────────────────────────
DOMAIN=netweaver.example.com
ACME_EMAIL=admin@example.com
# Set to "true" to use Let's Encrypt staging (for testing)
LETSENCRYPT_STAGING=false

# ─── JWT Authentication ──────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_64_BYTE_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CSRF_PROTECTION=true

# ─── Database (TimescaleDB) ──────────────────────────────────────────────
DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=netweaver
DB_USER=netweaver
# Generate with: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_GENERATE_A_SECURE_PASSWORD
POSTGRES_DB=${DB_NAME}
POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_GENERATE_A_SECURE_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ─── RabbitMQ ────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=netweaver
# Generate with: openssl rand -base64 32
RABBITMQ_PASS=CHANGE_ME_GENERATE_A_SECURE_PASSWORD

# ─── Service URLs (Docker internal) ──────────────────────────────────────
INTENT_ENGINE_URL=http://intent-engine:8081
DEVICE_MANAGER_URL=http://device-manager:8083
SELF_HEALING_URL=http://self-healing:8082
SECURITY_AGENT_URL=http://security-agent:8084

# ─── CORS / Allowed Origins ─────────────────────────────────────────────
ALLOWED_ORIGINS=https://${DOMAIN}

# ─── Rate Limiting ───────────────────────────────────────────────────────
RATE_LIMIT_GENERAL=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW=300

# ─── Monitoring ──────────────────────────────────────────────────────────
# SMTP for alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=CHANGE_ME
ALERT_EMAIL_TO=admin@example.com

# Slack webhook for alerts (optional)
SLACK_WEBHOOK_URL=

# ─── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Grafana ─────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
# Generate with: openssl rand -base64 16
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# ─── Admin User (Initial Setup) ─────────────────────────────────────────
ADMIN_USERNAME=admin
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_PASSWORD=CHANGE_ME_GENERATE_A_SECURE_PASSWORD
ADMIN_EMAIL=admin@example.com
